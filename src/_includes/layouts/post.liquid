---
layout: layouts/base.liquid
---
<article class="wrap prose-page">
  <header class="page-head">
    <h1>{{ title }}</h1>
    <p class="meta"><time datetime="{{ page.date | isoDate }}">{{ page.date | displayDate }}</time>{% if author %}, {{ author }}{% endif %}</p>
  </header>
  <div class="prose">
    {{ content }}
  </div>
  <p class="back"><a href="/news/">All news</a></p>
</article>
